# Copy to .env (dev: `pnpm dev:db` writes one for you). Production values in deploy/app-server/.env.production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# behind nginx in production
TRUST_PROXY=false

# PostgreSQL on the separate DB server. verify-full = TLS + CA + hostname check
DATABASE_URL=postgres://cardvault:CHANGE_ME@10.0.0.2:5432/cardvault
DATABASE_SSL=verify-full
DATABASE_CA_FILE=/run/secrets/db-ca.crt
DATABASE_POOL_MAX=10

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (losing it makes stored photos unreadable: back it up!)
IMAGE_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
MAX_IMAGE_BYTES=2097152

# public URL of the PWA (CORS + links in e-mails)
APP_URL=https://cardvault.example.it
COOKIE_SAMESITE=lax

# password-reset e-mails; without it they are only logged
SMTP_URL=smtps://user:password@smtp.example.it:465
MAIL_FROM=CardVault <no-reply@example.it>
