NODE_ENV=production
LOG_LEVEL=info

# from deploy/db-server/setup.sh output
DATABASE_URL=postgres://cardvault:PASSWORD@10.0.0.2:5432/cardvault
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=10

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32 — keep a copy OFF the server: without it card photos cannot be decrypted
IMAGE_ENCRYPTION_KEY=

APP_URL=https://cardvault.example.it
COOKIE_SAMESITE=lax

SMTP_URL=smtps://user:password@smtp.example.it:465
MAIL_FROM=CardVault <no-reply@example.it>
