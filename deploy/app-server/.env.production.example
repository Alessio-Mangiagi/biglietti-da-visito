NODE_ENV=production
LOG_LEVEL=info

# from deploy/db-server/setup.sh output
DATABASE_URL=postgres://cardvault:PASSWORD@10.0.0.2:5432/cardvault
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=10

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32 — keep a copy OFF the server: without it card photos cannot be decrypted
IMAGE_ENCRYPTION_KEY=

APP_URL=https://cardvault.example.it
COOKIE_SAMESITE=lax

SMTP_URL=smtps://user:password@smtp.example.it:465
MAIL_FROM=CardVault <no-reply@example.it>
# or AgentMail instead of SMTP (takes precedence when set)
# AGENTMAIL_API_KEY=
# auto = confirm e-mail at sign-up as soon as mail works; off to disable
EMAIL_VERIFICATION=auto

# reminder notifications (optional; uncomment all three, an empty value is an error):
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# at least 16 random characters (openssl rand -hex 24); /etc/cron.d/cardvault-reminders sends it
# CRON_SECRET=
